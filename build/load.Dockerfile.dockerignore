# BuildKit prefers <dockerfile>.dockerignore over the context-root .dockerignore. The
# context is narrowed to exactly what the image copies, so the provider folders under
# deployments/scripts/ and the service source never reach the build.
*
!build/load-entrypoint.sh
!deployments/scripts/DeploySharedSchemas.py
!deployments/scripts/Utility.py
!deployments/scripts/requirements.txt
!deployments/shared-schemas/
